.env
.venv/
__pycache__/
*.pyc
.mypy_cache/

# 원본 응답은 용량 큼 → 샘플 fixture(sample-*)만 커밋, 나머지 무시
raw/**/*
!raw/**/
!raw/**/sample-*

# 빌드 산출물 (web/public/data/*.json 은 git 기반 정적 배포를 위해 커밋함)
node_modules/
web/dist/
# SQLite 파생 인덱스(언제든 재생성, 바이너리) — 커밋 안 함
web/public/data/*.db

# 에이전트 세션 내부 파일
.jeo/

# 에이전트 survey 스크래치
.survey/

# zvec-grep 로컬 코드검색 인덱스 캐시(RocksDB/IPC, 재생성 가능) — 커밋 안 함
.zvec-grep/

# UI 검증 스냅샷(재생성 가능, 바이너리) — JSON 증거만 커밋
specs/verify/evidence/*.png
.vercel
.env*
